# Build-time config, passed with: fvm flutter run --dart-define-from-file=.env
# Nothing here ships as a file inside the app, but every value is compiled into
# the binary — only put keys that are safe to restrict by app (see below).
#
# Gemini, Tavily and Imgur keys are NOT here: they are Cloud Functions secrets
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set TAVILY_API_KEY
#   firebase functions:secrets:set IMGUR_CLIENT_ID

# YouTube API — restrict this key in the Google Cloud console to the iOS bundle
# id / Android package + SHA-1 and to "YouTube Data API v3" only.
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_BASE_URL=https://www.googleapis.com/youtube/v3

# One Piece API (devil fruits)
DEVIL_FRUIT_API_URL=https://api.api-onepiece.com/v2/fruits/en

# HuggingFace — use a fine-grained, read-only token limited to the Gemma model
# repository (Settings → Access Tokens → Fine-grained → "Read access to
# contents of selected repos"). It only downloads the model.
HUGGING_FACE_API_KEY=hf_your_token_here

# flutter_gemma on-device LLM
# Model: Gemma 4 E2B (.litertlm, downloaded once to device storage)
# Verify URL at: https://huggingface.co/litert-community/gemma-4-E2B-it-litert-lm
GEMMA_MODEL_URL=https://huggingface.co/litert-community/gemma-4-E2B-it-litert-lm/resolve/main/gemma-4-E2B-it.litertlm
GEMMA_MODEL_NAME=gemma-4-E2B-it.litertlm
# Lighter alternative (Gemma3-1B-IT, ~2.4 GB) — not the product default:
# GEMMA_MODEL_URL=https://huggingface.co/litert-community/Gemma3-1B-IT/resolve/main/Gemma3-1B-IT_multi-prefill-seq_q4_ekv4096.litertlm
# GEMMA_MODEL_NAME=gemma3_1b_it.litertlm

# App config
APP_NAME=One Piece Simple App

# Network (ms)
NETWORK_TIMEOUT=30000
