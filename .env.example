# YouTube API
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_BASE_URL=https://www.googleapis.com/youtube/v3

# One Piece API (characters + devil fruits)
ONEPIECE_API_URL=https://api.api-onepiece.com/v2/characters/en
DEVIL_FRUIT_API_URL=https://api.api-onepiece.com/v2/fruits/en

# HuggingFace — token used to download the flutter_gemma model
HUGGING_FACE_API_KEY=hf_your_token_here

# Gemini AI (cloud text/image generation)
GEMINI_API_KEY=your_gemini_api_key

# flutter_gemma on-device LLM
# Model: Gemma 4 E2B (.litertlm, downloaded once to device storage)
# Verify URL at: https://huggingface.co/litert-community/gemma-4-E2B-it-litert-lm
GEMMA_MODEL_URL=https://huggingface.co/litert-community/gemma-4-E2B-it-litert-lm/resolve/main/gemma-4-E2B-it.litertlm
GEMMA_MODEL_NAME=gemma-4-E2B-it.litertlm
# Lighter alternative (Gemma3-1B-IT, ~2.4 GB) — not the product default:
# GEMMA_MODEL_URL=https://huggingface.co/litert-community/Gemma3-1B-IT/resolve/main/Gemma3-1B-IT_multi-prefill-seq_q4_ekv4096.litertlm
# GEMMA_MODEL_NAME=gemma3_1b_it.litertlm

# Tavily — web search for VegapunkChat (1,000 free searches/month recurring)
# Sign up at https://tavily.com
TAVILY_API_KEY=tvly-your_key_here

# App config
APP_NAME=One Piece Simple App
APP_VERSION=1.0.1
DEBUG_MODE=true

# Network
NETWORK_TIMEOUT=30000
RETRY_COUNT=3

# Cache
CACHE_EXPIRY_TIME=3600000
